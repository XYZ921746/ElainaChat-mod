+/** 输入态的键盘提交：多行/编辑器里 Enter 换行，Ctrl/Cmd+Enter 提交；单行 Enter 提交。 */
+function bindModalInputKeys(elements, { input, multiline, useEditor, readValue, activeInput, finish }) {
+    if (!input) return;

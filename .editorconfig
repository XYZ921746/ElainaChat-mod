# 只规定 C# 源码的通用格式。
# 不写 end_of_line：仓库现有文件是 LF，而 Windows 上的编辑器默认 CRLF，
# 强制其中一种都会让"改一行"变成整文件 diff。

root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,sln}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

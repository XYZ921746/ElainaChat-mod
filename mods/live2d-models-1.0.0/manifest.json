{
  "id": "live2d-models",
  "name": "Live2D 引擎与模型",
  "version": "1.0.0",
  "description": "Live2D 运行引擎（Cubism Core / PIXI / pixi-live2d-display）与模型资源。含模型管理界面（上传/重命名/删除）。",
  "entry": "index.js",
  "styles": [],
  "defaultEnabled": true,
  "after": [],
  "hidden": false,
  "scripts": ["panel.js"],
  "capabilities": ["dragSort", "openFolder"],
  "server": {
    "entry": "server.mjs",
    "capabilities": ["route-register", "static-read", "host-utils"],
    "routes": ["/api/live2d"],
    "static": [
      { "url": "/live2d/models", "dir": "models" },
      { "url": "/live2d/vendor", "dir": "vendor", "mime": "auto" }
    ]
  }
}
